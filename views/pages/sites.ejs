<%- include('../partials/header') %>
<section class="dash">
  <div class="dh" style="display:flex;justify-content:space-between;align-items:flex-start">
    <div>
      <h1>🌐 Casino Sites</h1>
      <p>Browse all <%= stats?.total || 0 %> casino sites. Enable the ones you want the scraper to check.</p>
    </div>
    <div style="text-align:right">
      <div class="stat-badge">📡 <%= stats?.user_enabled_count || 0 %> enabled</div>
      <div class="stat-badge" style="margin-top:4px">🎯 <%= stats?.with_bonuses || 0 %> with bonuses</div>
    </div>
  </div>

  <% if (locals.error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (locals.registered) { %><div class="alert alert-success">🎉 Queued <%= registered %> sites for auto-registration!</div><% } %>
  <% if (locals.imported) { %><div class="alert alert-success">📥 Imported <%= imported %> sites from scraper config!</div><% } %>
  <% if (locals.search && sites.length === 0) { %><div class="alert alert-info">No sites matching "<%= search %>"</div><% } %>

  <!-- Search & Filters -->
  <div class="sites-toolbar">
    <form method="GET" action="/sites" class="search-form">
      <input type="text" name="q" value="<%= search %>" placeholder="Search sites..." class="search-input">
      <button type="submit" class="btn btn-sm btn-primary">Search</button>
      <% if (search) { %><a href="/sites" class="btn btn-sm btn-outline">Clear</a><% } %>
    </form>
    <div class="bulk-actions">
      <form method="POST" action="/sites/toggle-all" style="display:inline">
        <input type="hidden" name="action" value="enable">
        <button class="btn btn-sm btn-outline">Enable All</button>
      </form>
      <form method="POST" action="/sites/toggle-all" style="display:inline">
        <input type="hidden" name="action" value="disable">
        <button class="btn btn-sm btn-outline">Disable All</button>
      </form>
    </div>
  </div>

  <!-- Auto-Registration (all subscribers) -->
  <% if (locals.isSubscribed) { %>
  <div class="dc elite-card">
    <h3>🤖 Auto-Registration</h3>
    <p class="help">Generate accounts on all active casino sites automatically. Provide a username prefix and the base password.</p>
    <form method="POST" action="/sites/auto-signup" class="auto-signup-form">
      <div style="display:flex;gap:12px;align-items:end;flex-wrap:wrap">
        <div class="fg" style="flex:1;min-width:150px">
          <label>Username Prefix</label>
          <input type="text" name="username_prefix" placeholder="e.g. user123" required>
        </div>
        <div class="fg" style="flex:1;min-width:150px">
          <label>Base Password</label>
          <input type="text" name="base_password" value="AutoGen123!">
        </div>
        <button type="submit" class="btn btn-primary">🚀 Start Auto-Registration</button>
      </div>
      <p class="help" style="margin-top:6px">Usernames will be: <code>{prefix}_{site_name}</code>. One account per site.</p>
    </form>
    <div id="regProgress" style="display:none;margin-top:12px">
      <div class="progress-bar"><div class="progress-fill" id="regFill" style="width:0%"></div></div>
      <p class="help" id="regStatus">Processing...</p>
    </div>
  </div>
  <% } %>

  <!-- Sites Grid -->
  <div class="sites-grid">
    <% (locals.sites || []).forEach(site => { %>
      <div class="site-card <%= site.user_enabled ? 'enabled' : '' %>">
        <div class="sc-header">
          <h4><%= site.name || site.url.replace(/^https?:\/\//, '').slice(0, 30) %></h4>
          <span class="sc-status <%= site.user_enabled ? 'on' : 'off' %>">
            <%= site.user_enabled ? 'ON' : 'OFF' %>
          </span>
        </div>
        <div class="sc-url"><%= site.url.slice(0, 40) %><%= site.url.length > 40 ? '…' : '' %></div>
        <div class="sc-stats">
          <span>🎯 <%= site.bonuses_count || 0 %> bonuses</span>
          <% if (site.last_scraped) { %><span>🕐 <%= new Date(site.last_scraped).toLocaleDateString() %></span><% } %>
        </div>
        <form method="POST" action="/sites/<%= site.id %>/toggle">
          <button class="btn btn-sm <%= site.user_enabled ? 'btn-outline' : 'btn-primary' %> btn-block">
            <%= site.user_enabled ? 'Disable' : 'Enable' %>
          </button>
        </form>
      </div>
    <% }) %>
  </div>

  <!-- Seed from scraper (hidden but accessible) -->
  <div style="text-align:center;margin-top:24px">
    <a href="/sites/seed" class="btn btn-sm btn-outline">📥 Import Sites from Scraper Config</a>
  </div>
</section>

<script>
// Auto-registration progress polling
document.querySelector('.auto-signup-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const prog = document.getElementById('regProgress');
  const fill = document.getElementById('regFill');
  const status = document.getElementById('regStatus');
  
  // Submit form via fetch
  const resp = await fetch(form.action, { method: 'POST', body: new FormData(form) });
  if (resp.redirected) {
    window.location.href = resp.url;
    return;
  }
  
  prog.style.display = 'block';
  const interval = setInterval(async () => {
    const r = await fetch('/sites/registration-status');
    const d = await r.json();
    const pct = d.total > 0 ? ((d.completed + d.failed) / d.total * 100) : 0;
    fill.style.width = pct + '%';
    status.textContent = `Completed: ${d.completed}, Failed: ${d.failed}, Pending: ${d.pending}`;
    if (d.pending === 0 && d.processing === 0) clearInterval(interval);
  }, 2000);
});
</script>

<style>
.stat-badge { font-size: 0.8rem; color: var(--text-muted); }
.sites-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
.search-form { display: flex; gap: 6px; flex: 1; }
.search-input { flex: 1; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--text); font-size: 0.85rem; }
.bulk-actions { display: flex; gap: 6px; }
.elite-card { margin-bottom: 20px; }
.auto-signup-form .fg { margin-bottom: 0; }
.auto-signup-form label { font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 2px; }
.auto-signup-form input { width: 100%; padding: 8px 10px; font-size: 0.85rem; }
.progress-bar { height: 8px; background: var(--surface-2); border-radius: 4px; overflow: hidden; }
.progress-fill { height: 100%; background: var(--primary); transition: width 0.5s; }
.sites-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
.site-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; transition: all 0.2s; }
.site-card.enabled { border-color: var(--primary); }
.sc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.sc-header h4 { font-size: 0.85rem; margin: 0; }
.sc-status { font-size: 0.65rem; font-weight: 700; padding: 2px 8px; border-radius: 10px; }
.sc-status.on { background: var(--success); color: #fff; }
.sc-status.off { background: var(--surface-2); color: var(--text-muted); }
.sc-url { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 8px; word-break: break-all; }
.sc-stats { display: flex; gap: 10px; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 10px; }
.btn-block { width: 100%; }
@media (max-width: 640px) { .sites-grid { grid-template-columns: 1fr; } }
</style>
<%- include('../partials/footer') %>
