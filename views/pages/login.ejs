<%- include('../partials/header') %>
<section class="ap"><div class="ac">
  <h1>Welcome Back</h1>
  <% if (locals.error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (locals.registered) { %><div class="alert alert-success">Account created! Please log in.</div><% } %>
  <form method="POST" action="/login">
    <% if (locals.tier) { %><input type="hidden" name="tier" value="<%= tier %>"><% } %>
    <div class="fg"><label>Email</label><input type="email" name="email" placeholder="you@example.com" required></div>
    <div class="fg"><label>Password</label><input type="password" name="password" placeholder="Your password" required></div>
    <button type="submit" class="btn btn-primary btn-block">Log In</button>
  </form>
  <p class="al">Don't have an account? <a href="/signup<%= locals.tier ? '?tier=' + tier : '' %>">Sign up</a></p>
</div></section>
<%- include('../partials/footer') %>
