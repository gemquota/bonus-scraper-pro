<%- include('../partials/header') %>
<section class="pi">
  <div class="pi-badge">🎯 BONUS SCRAPER PRO</div>
  <h1>Choose Your Tier & Period</h1>
  <p class="pi-sub">Free first month on Starter monthly. No free tier beyond that — pick your scraping schedule.</p>

  <% if (locals.checkout === 'cancelled') { %><div class="alert alert-info">Checkout cancelled.</div><% } %>

  <div class="period-toggle">
    <button class="pt-btn active" data-period="weekly">Weekly</button>
    <button class="pt-btn" data-period="monthly">Monthly</button>
    <button class="pt-btn" data-period="quarterly">Quarterly</button>
    <button class="pt-btn" data-period="annual">Annual</button>
  </div>

  <div class="tp-grid">
    <!-- Starter -->
    <div class="tp-card">
      <h3>Starter</h3>
      <div class="tp-price">
        <span class="price-amount" data-tier="tier1">$6</span>
        <small class="price-period">/wk</small>
      </div>
      <div class="tp-days">
        <span class="d active">M</span><span class="d">T</span><span class="d">W</span><span class="d">T</span><span class="d">F</span><span class="d">S</span><span class="d">S</span>
      </div>
      <p>Monday scrape · Standard Data</p>
      <ul class="tp-features">
        <li>✓ CSV Export</li>
        <li>✕ JSON Export</li>
        <li>✕ Value Scoring</li>
        <li>✕ Full-Text Search</li>
        <li>✕ Auto-Registration</li>
      </ul>
      <% if (locals.customer) { %>
        <button class="btn btn-primary btn-block" onclick="checkout('tier1')">
          Subscribe <span class="price-amount" data-tier="tier1">$6</span><span class="price-period">/wk</span>
        </button>
      <% } else { %>
        <a href="/signup?tier=tier1" class="btn btn-primary btn-block">Choose Starter</a>
      <% } %>
      <p class="tp-trial">Free first month</p>
    </div>

    <!-- Pro -->
    <div class="tp-card feat">
      <div class="tp-badge">POPULAR</div>
      <h3>Pro</h3>
      <div class="tp-price">
        <span class="price-amount" data-tier="tier2">$12</span>
        <small class="price-period">/wk</small>
      </div>
      <div class="tp-days">
        <span class="d active">M</span><span class="d">T</span><span class="d">W</span><span class="d active">T</span><span class="d">F</span><span class="d active">S</span><span class="d">S</span>
      </div>
      <p>Mon + Thu + Sat · Advanced Data</p>
      <ul class="tp-features">
        <li>✓ CSV Export</li>
        <li>✓ JSON Export</li>
        <li>✓ Value Scoring</li>
        <li>✕ Full-Text Search</li>
        <li>✕ Auto-Registration</li>
      </ul>
      <% if (locals.customer) { %>
        <button class="btn btn-primary btn-block" onclick="checkout('tier2')">
          Subscribe <span class="price-amount" data-tier="tier2">$12</span><span class="price-period">/wk</span>
        </button>
      <% } else { %>
        <a href="/signup?tier=tier2" class="btn btn-primary btn-block">Choose Pro</a>
      <% } %>
    </div>

    <!-- Elite -->
    <div class="tp-card">
      <h3>Elite</h3>
      <div class="tp-price">
        <span class="price-amount" data-tier="tier3">$24</span>
        <small class="price-period">/wk</small>
      </div>
      <div class="tp-days">
        <span class="d active">M</span><span class="d active">T</span><span class="d active">W</span><span class="d active">T</span><span class="d active">F</span><span class="d active">S</span><span class="d active">S</span>
      </div>
      <p>Daily · Expert Data</p>
      <ul class="tp-features">
        <li>✓ CSV Export</li>
        <li>✓ JSON Export</li>
        <li>✓ Value Scoring</li>
        <li>✓ Full-Text Search</li>
        <li>✓ Auto-Registration</li>
      </ul>
      <% if (locals.customer) { %>
        <button class="btn btn-primary btn-block" onclick="checkout('tier3')">
          Subscribe <span class="price-amount" data-tier="tier3">$24</span><span class="price-period">/wk</span>
        </button>
      <% } else { %>
        <a href="/signup?tier=tier3" class="btn btn-primary btn-block">Choose Elite</a>
      <% } %>
    </div>
  </div>

  <div class="period-breakdown">
    <h2>📊 Cost Comparison — What Each Period Equates To</h2>

    <div class="pb-table">
      <h3>If You Pay Weekly</h3>
      <table>
        <tr><th>Period</th><th>Starter</th><th>Pro</th><th>Elite</th></tr>
        <tr><td>Weekly</td><td><strong>$6/wk</strong></td><td><strong>$12/wk</strong></td><td><strong>$24/wk</strong></td></tr>
        <tr><td>Monthly</td><td>$26/mo</td><td>$52/mo</td><td>$104/mo</td></tr>
        <tr><td>Quarterly</td><td>$78/qtr</td><td>$156/qtr</td><td>$312/qtr</td></tr>
        <tr><td>Annual</td><td>$312/yr</td><td>$624/yr</td><td>$1,248/yr</td></tr>
      </table>
    </div>

    <div class="pb-table">
      <h3>If You Pay Monthly</h3>
      <table>
        <tr><th>Period</th><th>Starter</th><th>Pro</th><th>Elite</th></tr>
        <tr><td>Weekly</td><td>$5/wk</td><td>$8/wk</td><td>$16/wk</td></tr>
        <tr><td>Monthly</td><td><strong>$20/mo</strong></td><td><strong>$35/mo</strong></td><td><strong>$70/mo</strong></td></tr>
        <tr><td>Quarterly</td><td>$60/qtr</td><td>$105/qtr</td><td>$210/qtr</td></tr>
        <tr><td>Annual</td><td>$240/yr</td><td>$420/yr</td><td>$840/yr</td></tr>
      </table>
    </div>

    <div class="pb-table">
      <h3>If You Pay Quarterly</h3>
      <table>
        <tr><th>Period</th><th>Starter</th><th>Pro</th><th>Elite</th></tr>
        <tr><td>Weekly</td><td>$4/wk</td><td>$7/wk</td><td>$14/wk</td></tr>
        <tr><td>Monthly</td><td>$17/mo</td><td>$30/mo</td><td>$60/mo</td></tr>
        <tr><td>Quarterly</td><td><strong>$50/qtr</strong></td><td><strong>$90/qtr</strong></td><td><strong>$180/qtr</strong></td></tr>
        <tr><td>Annual</td><td>$200/yr</td><td>$360/yr</td><td>$720/yr</td></tr>
      </table>
    </div>

    <div class="pb-table">
      <h3>If You Pay Annually</h3>
      <table>
        <tr><th>Period</th><th>Starter</th><th>Pro</th><th>Elite</th></tr>
        <tr><td>Weekly</td><td>$3/wk</td><td>$6/wk</td><td>$12/wk</td></tr>
        <tr><td>Monthly</td><td>$15/mo</td><td>$25/mo</td><td>$50/mo</td></tr>
        <tr><td>Quarterly</td><td>$45/qtr</td><td>$75/qtr</td><td>$150/qtr</td></tr>
        <tr><td>Annual</td><td><strong>$180/yr</strong></td><td><strong>$300/yr</strong></td><td><strong>$600/yr</strong></td></tr>
      </table>
    </div>
  </div>
</section>

<script>
const PRICES = {
  tier1: { weekly: '$6', monthly: '$20', quarterly: '$50', annual: '$180' },
  tier2: { weekly: '$12', monthly: '$35', quarterly: '$90', annual: '$300' },
  tier3: { weekly: '$24', monthly: '$70', quarterly: '$180', annual: '$600' },
};
const PERIODS = { weekly: '/wk', monthly: '/mo', quarterly: '/qtr', annual: '/yr' };

document.querySelectorAll('.pt-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.pt-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const period = btn.dataset.period;
    document.querySelectorAll('.price-amount').forEach(el => {
      const tier = el.dataset.tier;
      if (tier && PRICES[tier]) el.textContent = PRICES[tier][period];
    });
    document.querySelectorAll('.price-period').forEach(el => el.textContent = PERIODS[period]);
  });
});

async function checkout(tier) {
  const period = document.querySelector('.pt-btn.active')?.dataset.period || 'monthly';
  try {
    const r = await fetch('/payments/checkout/' + tier + '?period=' + period, { method: 'POST' });
    const d = await r.json();
    if (d.url) window.location.href = d.url;
  } catch(err) { alert('Checkout error: ' + err.message); }
}
</script>

<style>
.pi { padding: 60px 0; text-align: center; }
.pi-badge { display: inline-block; background: linear-gradient(135deg, var(--primary), #e17055); color: #fff; padding: 6px 20px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; margin-bottom: 16px; }
.pi h1 { font-size: 2.4rem; margin-bottom: 6px; }
.pi-sub { color: var(--text-muted); margin-bottom: 32px; max-width: 550px; margin-left: auto; margin-right: auto; }
.period-toggle { display: flex; gap: 8px; justify-content: center; margin-bottom: 32px; flex-wrap: wrap; }
.pt-btn { padding: 10px 28px; border: 2px solid var(--border); border-radius: 30px; background: transparent; color: var(--text-muted); cursor: pointer; font-size: 0.95rem; font-weight: 600; transition: all 0.2s; }
.pt-btn:hover { border-color: var(--primary); color: var(--text); }
.pt-btn.active { background: var(--primary); border-color: var(--primary); color: #fff; }
.tp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 800px; margin: 0 auto; }
.tp-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px 20px; position: relative; display: flex; flex-direction: column; }
.tp-card.feat { border-color: var(--primary); }
.tp-badge { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--primary); color: #fff; padding: 3px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; }
.tp-card h3 { font-size: 1.1rem; margin-bottom: 4px; }
.tp-price { font-size: 2rem; font-weight: 700; margin-bottom: 12px; }
.tp-price small { font-size: 0.85rem; color: var(--text-muted); font-weight: 400; }
.tp-days { display: flex; gap: 4px; justify-content: center; margin-bottom: 8px; }
.tp-days .d { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; background: var(--surface-2); color: var(--text-muted); }
.tp-days .d.active { background: var(--primary); color: #fff; }
.tp-card p { color: var(--text-muted); font-size: 0.8rem; margin-bottom: 12px; }
.tp-features { list-style: none; text-align: left; font-size: 0.8rem; margin-bottom: 16px; flex: 1; }
.tp-features li { padding: 4px 0; color: var(--text-muted); }
.tp-trial { font-size: 0.75rem; color: var(--text-muted); margin-top: 6px; }
.alert { padding: 12px; border-radius: var(--radius); margin-bottom: 16px; font-size: 0.85rem; }
.alert-info { background: #2d4a7a; color: #fff; }

.period-breakdown { max-width: 800px; margin: 48px auto 0; text-align: left; }
.period-breakdown h2 { text-align: center; font-size: 1.3rem; margin-bottom: 28px; }
.pb-table { margin-bottom: 28px; }
.pb-table h3 { font-size: 0.95rem; margin-bottom: 8px; color: var(--primary); }
.pb-table table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
.pb-table th, .pb-table td { padding: 8px 14px; border-bottom: 1px solid var(--border); text-align: left; }
.pb-table th { color: var(--text-muted); font-weight: 600; }
.pb-table td strong { color: var(--primary); }

@media (max-width: 700px) { .tp-grid { grid-template-columns: 1fr; } }
</style>
<%- include('../partials/footer') %>
