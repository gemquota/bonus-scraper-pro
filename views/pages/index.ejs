<%- include('../partials/header') %>
<section class="hero">
  <div class="hero-badge">🕸️  BONUS SCRAPER PRO</div>
  <h1>Fresh Bonus Data<br>from 1,000+ Casino Sites</h1>
  <p class="hero-sub">One plan. All features. Pick how you pay — weekly, monthly, quarterly, or annual. First month free.</p>
  <div class="hero-actions">
    <a href="/signup" class="btn btn-primary btn-lg">Start Free Trial →</a>
    <a href="/pricing" class="btn btn-outline btn-lg">See Pricing</a>
  </div>
</section>

<section class="how">
  <h2>How It Works</h2>
  <div class="steps">
    <div class="step">
      <div class="step-num">1</div>
      <h4>Subscribe</h4>
      <p>First month free on the monthly plan. Cancel anytime.</p>
    </div>
    <div class="step">
      <div class="step-num">2</div>
      <h4>We Scrape Daily</h4>
      <p>Our engine hits all 1,000+ casino sites every day. Expert-grade data.</p>
    </div>
    <div class="step">
      <div class="step-num">3</div>
      <h4>Get Data</h4>
      <p>Download fresh bonus data in CSV, JSON, or raw. Full-text search, value scoring, filtered export.</p>
    </div>
  </div>
</section>

<section class="features-preview">
  <h2>Everything Included</h2>
  <div class="fp-grid">
    <div class="fp-item">✓ Daily scrapes</div>
    <div class="fp-item">✓ Expert data level</div>
    <div class="fp-item">✓ CSV + JSON + Raw export</div>
    <div class="fp-item">✓ Full-text search</div>
    <div class="fp-item">✓ Value scoring</div>
    <div class="fp-item">✓ Filtered export</div>
    <div class="fp-item">✓ Custom fields</div>
    <div class="fp-item">✓ Auto-registration</div>
    <div class="fp-item">✓ Priority support</div>
    <div class="fp-item">✓ 1,000+ casino sites</div>
  </div>
</section>

<style>
.hero-badge { display: inline-block; background: linear-gradient(135deg, var(--primary), #e17055); color: #fff; padding: 6px 20px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; margin-bottom: 16px; }
.hero { text-align: center; padding: 80px 20px 40px; }
.hero h1 { font-size: 2.8rem; line-height: 1.15; margin-bottom: 16px; }
.hero-sub { font-size: 1.05rem; color: var(--text-muted); max-width: 550px; margin: 0 auto 32px; }
.hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.how { text-align: center; padding: 60px 0; }
.how h2 { margin-bottom: 32px; }
.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 700px; margin: 0 auto; }
.step { padding: 20px; }
.step-num { width: 40px; height: 40px; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 12px; }
.step h4 { margin-bottom: 6px; }
.step p { color: var(--text-muted); font-size: 0.9rem; }
.features-preview { text-align: center; padding: 40px 0; }
.features-preview h2 { margin-bottom: 24px; }
.fp-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; max-width: 500px; margin: 0 auto; }
.fp-item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; font-size: 0.9rem; text-align: center; }
@media (max-width: 600px) { .hero h1 { font-size: 2rem; } .steps { grid-template-columns: 1fr; } .fp-grid { grid-template-columns: 1fr; } }
</style>
<%- include('../partials/footer') %>
